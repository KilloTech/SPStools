# Only one job per LEO satellite will run at a certain time {using flock()}.

# Aqua:  Maximum timeliness 14143 seconds, overhead eurol DAY 12:57 + 05:00
57 17 * * * eumetcast $LEO Aqua-eurol.py now DAY 300  >/dev/null 2>&1
# Aqua:  Maximum timeliness 14143 seconds, overhead eurol NIG 02:11 + 05:00
11 7 * * * eumetcast $LEO Aqua-eurol.py now NIG 300  >/dev/null 2>&1

# Aqua:  Maximum timeliness 14143 seconds, overhead isleofman DAY 13:08 + 05:00
8 18 * * * eumetcast $LEO Aqua-isleofman.py now DAY 300  >/dev/null 2>&1
# Aqua:  Maximum timeliness 14143 seconds, overhead isleofman NIG 02:41 + 05:00
41 7 * * * eumetcast $LEO Aqua-isleofman.py now NIG 300  >/dev/null 2>&1

# Terra: Maximum timeliness 14324 seconds, overhead eurol DAY 10:55 + 05:00
55 15 * * * eumetcast $LEO Terra-eurol.py now DAY 300  >/dev/null 2>&1
# Terra: Maximum timeliness 14324 seconds, overhead eurol NIG 21:41 + 05:00
41 2 * * * eumetcast $LEO Terra-eurol.py -5hours NIG 300  >/dev/null 2>&1

# Terra: Maximum timeliness 14324 seconds, overhead isleofman DAY 11:25 + 05:00
25 16 * * * eumetcast $LEO Terra-isleofman.py now DAY 300  >/dev/null 2>&1
# Terra: Maximum timeliness 14324 seconds, overhead isleofman NIG 21:53 + 05:00
53 2 * * * eumetcast $LEO Terra-isleofman.py -5hours NIG 300  >/dev/null 2>&1


# Metop Global Data Service (GDS) /https://www.eumetsat.int/metop-gds
# Timeliness AVHRR Level 1 =  2hrs 15mins / WORST CASE ADD 3hrs 6mins

# Measured with own script MetopB: Maximum timeliness 3661 seconds
# Overhead isleofman DAY 10:37 + 02:00
37 12 * * * eumetcast $LEO MetopB-isleofman.py now DAY 300  >/dev/null 2>&1
# Overhead isleofman NIG 20:59 + 02:00
59 22 * * * eumetcast $LEO MetopB-isleofman.py now NIG 300  >/dev/null 2>&1

# Measured with own script MetopC: Maximum timeliness 6266 seconds
# Overhead isleofman DAY 10:38 + 02:45
23 13 * * * eumetcast $LEO MetopC-isleofman.py now DAY 300  >/dev/null 2>&1
# Overhead isleofman NIG 21:00 + 02:45
45 23 * * * eumetcast $LEO MetopC-isleofman.py now NIG 300  >/dev/null 2>&1


# For EARS disseminated LEO satellites add 50+30=80 Minutes to optimum overhead
# FY3D: overhead svalbard DAY 09:08 + 01:20
28 10 * * * eumetcast $LEO FY3D-svalbard.py now DAY 300  >/dev/null 2>&1
# FY3D: overhead svalbard NIG 03:45 + 01:20
5 5 * * * eumetcast $LEO FY3D-svalbard.py now NIG 300  >/dev/null 2>&1
# NOAA20: overhead switzerland DAY 12:14 + 01:20
33 13 * * * eumetcast $LEO NOAA20-switzerland.py now DAY 300  >/dev/null 2>&1
# NOAA20: overhead switzerland NIG 01:30 + 01:20
49 2 * * * eumetcast $LEO NOAA20-switzerland.py now NIG 300  >/dev/null 2>&1
# SNPP: overhead switzerland DAY 12:14 + 01:20
35 13 * * * eumetcast $LEO SNPP-switzerland.py now DAY 300  >/dev/null 2>&1
# SNPP: overhead switzerland NIG 01:30 + 01:20
51 2 * * * eumetcast $LEO SNPP-switzerland.py now NIG 300  >/dev/null 2>&1


# Sentinel-3A and Sentinel-3B are expected overhead Switzerland 10:04 UTC
# Maximum timeliness measured with own script S3A=10981 S3B=10621 seconds
# We schedule Sentinel-3X satellites 10:04 + 3.05 hours + 1 hour (slack)!
4  14 * * * eumetcast $LEO Sen3A-switzerland.py now DAY 300  >/dev/null 2>&1
8  14 * * * eumetcast $LEO Sen3B-switzerland.py now DAY 300  >/dev/null 2>&1
12 14 * * * eumetcast $LEO Sen3X-switzerland.py now DAY 300  >/dev/null 2>&1


# Make four NOAA Ocean Prediction Center (OPC) overlays (Atlantic and Pacific)
45 3-21/6 * * * eumetcast $CMD/OPC-overlays.sh  >/dev/null 2>&1
# Make NOAA/OPC MSLP overlays every 6 hours for MSG4, GOES16, GOES18 and HIMA8
50 3-21/6 * * * eumetcast $GEO MSG4-MSLP-opcae.py   -230min 300  >/dev/null 2>&1
53 3-21/6 * * * eumetcast $GEO GOES16-MSLP-opcaw.py -233min 300  >/dev/null 2>&1
56 3-21/6 * * * eumetcast $GEO GOES18-MSLP-opcpe.py -236min 300  >/dev/null 2>&1
59 3-21/6 * * * eumetcast $GEO HIMA8-MSLP-opcpw.py  -239min 300  >/dev/null 2>&1

# Make UK-MetOffice (UKMO) small/large/xlarge overlays. To be optimized ...
5  2,8,14,20 * * * eumetcast $CMD/UKMO-overlays.sh  >/dev/null 2>&1
10 2,8,14,20 * * * eumetcast $CMD/DWDSAT-overlays.py  >/dev/null 2>&1
15 2,8,14,20 * * * eumetcast $GEO MSG4-MSLP-ukmox.py -135min 300  >/dev/null 2>&1

# Make Deutscher Wetter Dienst (DWD) overlays. To be optimized ...
0 * * * * eumetcast $CMD/DWD-overlays.sh  >/dev/null 2>&1
30 1-22/3 * * * eumetcast $GEO MSG4-MSLP-dwdx.py -270min 300  >/dev/null 2>&1

# Tydy old EUMETCast frames, images, movies, etc.
20 0 * * * eumetcast $CMD/tidy.sh >/dev/null 2>&1
