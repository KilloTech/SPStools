# /etc/crontab: system-wide crontab
# Unlike any other crontab you don't have to run the `crontab'
# command to install the new version when you edit this file
# and files in /etc/cron.d. These files also have username fields,
# that none of the other crontabs do.

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Example of job definition:
# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * user-name command to be executed
17 *	* * *	root    cd / && run-parts --report /etc/cron.hourly
25 6	* * *	root	test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.daily )
47 6	* * 7	root	test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.weekly )
52 6	1 * *	root	test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.monthly )
#
#
# Added for eluna graphing    E. Lobsiger
# This starts at minutes 0,5,10,15,...,55
*/5 * * * * root /var/www/eluna/update.pl > /dev/null 2>&1
# Show a top on the web       E. Lobsiger
*/2 * * * * root /usr/bin/top -b -n 1 > /var/www/txt/top.txt
# Show 100 lines of recv_0.log  (BASIC) E. Lobsiger
*/5 * * * * root /usr/bin/tail -n 100 /var/log/tellicast-client/recv_bas.log > /var/www/txt/recv_0.txt
# Show 100 lines of recv_1.log  (HVS-1) E. Lobsiger
*/5 * * * * root /usr/bin/tail -n 100 /var/log/tellicast-client/recv_hvs-1.log > /var/www/txt/recv_1.txt
# Show 100 lines of recv_2.log  (HVS-2) E. Lobsiger
*/5 * * * * root /usr/bin/tail -n 100 /var/log/tellicast-client/recv_hvs-2.log > /var/www/txt/recv_2.txt

#
# ****************************************
# It is always good to RTFM: man 5 crontab
# ****************************************
# Crontab for Kallisto and Luna 2022-12-10
#

# Added for data transfer RAM disk /opt  -> /dev/md0
# This starts at minutes 1,3,5,7,9, ... ,57,59
0-59/1 * * * * root /root/bash/mvopt > /dev/null 2>&1

# Added to delete files on /srv (deletes full days)
51 23 * * * root /root/bash/rmoldstuff > /dev/null 2>&1

# My CMD port and bash backport of Arne van Belle's TClogAnalyzer
12 2 * * *  root  /root/bash/TClogSummary_0 yesterday > /dev/null 2>&1
13 2 * * *  root  /root/bash/TClogSummary_1 yesterday > /dev/null 2>&1
14 2 * * *  root  /root/bash/TClogSummary_2 yesterday > /dev/null 2>&1

# Added for my TelliCastStatsCollector.cmd port of David and Arne
29,59 * * * * root /root/bash/TelliCastStatsCollector_0 > /dev/null 2>&1
29,59 * * * * root /root/bash/TelliCastStatsCollector_1 > /dev/null 2>&1
29,59 * * * * root /root/bash/TelliCastStatsCollector_2 > /dev/null 2>&1


# Defining variables makes the command lines below much shorter (RTFM).
CMD=/home/eumetcast/SPStools/cmdfiles
GEO=/home/eumetcast/SPStools/cmdfiles/GEO-pic.sh
LEO=/home/eumetcast/SPStools/cmdfiles/LEO-pic.sh
MOV=/home/eumetcast/SPStools/cmdfiles/GEO-mov.sh

# This will start a PyTROLL/Satpy jobs running in miniconda3 as user eumetcast
# GEOESX and HIMA8 satellites are now scheduled earlier after new measurements
1-56/5  * * * * eumetcast $GEO MSG3-isomrss.py     -11min 200  >/dev/null 2>&1
2-57/5  * * * * eumetcast $GEO MSG3-oaserss.py     -12min 200  >/dev/null 2>&1
1-46/15 * * * * eumetcast $GEO MSG4-msg_fes_rss.py -31min 300  >/dev/null 2>&1
2-47/15 * * * * eumetcast $GEO MSG2-msg_ioc_rss.py -32min 300  >/dev/null 2>&1
0-50/10 * * * * eumetcast $GEO HIMA8-hima_f_rss.py   -40min 300 >/dev/null 2>&1
5-55/10 * * * * eumetcast $GEO GOES16-goes_ef_rss.py -45min 300 >/dev/null 2>&1
6-56/10 * * * * eumetcast $GEO GOES16-caribbean.py -46min 300 >/dev/null 2>&1
7-57/10 * * * * eumetcast $GEO GOES18-goes_wf_rss.py -47min 300 >/dev/null 2>&1
# Above MSG4 "frames" are made  .., 31, 46,.. so we start 5 minutes later
35 * * * * eumetcast $GEO MSG4-westminster.py -35min 300  >/dev/null 2>&1
39 * * * * eumetcast $GEO MSG2-afghanistan.py -39min 300  >/dev/null 2>&1

